HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
# Local: http://localhost:3000 — on koekje/cms: https://test.merkdraak.nl
# Used for pagebuilder iframe (Site.editorUrl) + optional EDITOR_PUBLIC_URL override.
FRONTEND_URL=http://localhost:3000
REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=change-me
EDITOR_SECRET=change-me
# Optional. Defaults to FRONTEND_URL. Must match the deployed Next editor origin.
# EDITOR_PUBLIC_URL=https://test.merkdraak.nl
# Admin token from Strapi admin: Settings → Admin tokens. Read by Claude Code via .mcp.json.
STRAPI_ADMIN_TOKEN=

# --- Form e-mail (credentials only via env; never store secrets in CMS) ---
# Choose provider in Settings → E-mail. Only fill vars for the active provider.

# SMTP / Nodemailer (e.g. Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_DEFAULT_FROM=beheer@merkdraak.nl
SMTP_DEFAULT_REPLY_TO=beheer@merkdraak.nl

# Resend
RESEND_API_KEY=

# SendGrid
SENDGRID_API_KEY=

# Mailgun
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
# MAILGUN_BASE_URL=https://api.eu.mailgun.net

# Postmark
POSTMARK_API_KEY=

# Amazon SES (SigV4 API)
AWS_SES_REGION=eu-west-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=

# Optional SMS confirmation
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=
