{
  "kind": "collectionType",
  "collectionName": "pages",
  "info": {
    "singularName": "page",
    "pluralName": "pages",
    "displayName": "Pagina",
    "description": "Titel, URL, status en blokken. Technische sleutels vult het systeem zelf."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "content-manager": {
      "visible": true
    }
  },
  "attributes": {
    "site": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::site.site"
    },
    "siteKey": {
      "type": "string",
      "required": true
    },
    "entryKey": {
      "type": "string",
      "required": true
    },
    "scopeKey": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "title": {
      "type": "string"
    },
    "navLabel": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "pageType": {
      "type": "enumeration",
      "enum": [
        "home",
        "company",
        "overview",
        "service",
        "case",
        "knowledge"
      ],
      "default": "company"
    },
    "cluster": {
      "type": "string"
    },
    "phase": {
      "type": "integer",
      "default": 1
    },
    "visibility": {
      "type": "enumeration",
      "enum": [
        "planned",
        "concept",
        "published"
      ],
      "default": "planned"
    },
    "publishAt": {
      "type": "datetime"
    },
    "composed": {
      "type": "boolean",
      "default": true
    },
    "seoTitle": {
      "type": "string"
    },
    "description": {
      "type": "text"
    },
    "canonicalUrl": {
      "type": "string"
    },
    "ogTitle": {
      "type": "string"
    },
    "ogDescription": {
      "type": "text"
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "cardImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "cardIcon": {
      "type": "string",
      "default": ""
    },
    "nofollow": {
      "type": "boolean",
      "default": false
    },
    "showInMenu": {
      "type": "boolean",
      "default": false
    },
    "authorName": {
      "type": "string"
    },
    "publishedOn": {
      "type": "date"
    },
    "formEmail": {
      "type": "string"
    },
    "formThanks": {
      "type": "text"
    },
    "formRedirect": {
      "type": "string"
    },
    "intro": {
      "type": "text"
    },
    "eyebrow": {
      "type": "string"
    },
    "cta": {
      "type": "enumeration",
      "enum": [
        "marketingscan",
        "websitescan",
        "contact",
        "cases"
      ],
      "default": "marketingscan"
    },
    "parent": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::page.page"
    },
    "related": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::page.page"
    },
    "sections": {
      "type": "dynamiczone",
      "components": [
        "sections.hero",
        "sections.client-logos",
        "sections.service-cards",
        "sections.results",
        "sections.case-grid",
        "sections.testimonial",
        "sections.process",
        "sections.why-us",
        "sections.team",
        "sections.contact-cta",
        "sections.contact-form",
        "sections.scan-request-form",
        "sections.vacancy-application-form",
        "sections.notice",
        "sections.prose",
        "sections.bullet-list",
        "sections.numbered-steps",
        "sections.faq",
        "sections.price-factors",
        "sections.case-story",
        "sections.page-index",
        "sections.link-list",
        "sections.image-slider",
        "sections.image",
        "sections.video",
        "sections.row",
        "sections.heading",
        "sections.button",
        "sections.divider",
        "sections.spacer",
        "sections.split",
        "sections.takeaways",
        "sections.table",
        "sections.columns",
        "sections.cards",
        "sections.vacancies",
        "sections.accordion",
        "sections.expert",
        "sections.sources",
        "sections.gallery",
        "sections.before-after",
        "sections.reviews",
        "sections.location",
        "sections.map-embed",
        "sections.document",
        "sections.button-row"
      ]
    }
  }
}
