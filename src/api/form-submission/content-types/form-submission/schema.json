{
  "kind": "collectionType",
  "collectionName": "form_submissions",
  "info": {
    "singularName": "form-submission",
    "pluralName": "form-submissions",
    "displayName": "Formulierinzending",
    "description": "Niet openbaar op de site. Alleen zichtbaar in het beheerpaneel."
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    },
    "content-type-builder": {
      "visible": false
    }
  },
  "attributes": {
    "siteKey": {
      "type": "string",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "email": {
      "type": "string",
      "required": true
    },
    "phone": {
      "type": "string"
    },
    "message": {
      "type": "text",
      "required": true
    },
    "interest": {
      "type": "string"
    },
    "requestType": {
      "type": "enumeration",
      "enum": ["contact", "seo", "sea", "cro"],
      "default": "contact",
      "required": true
    },
    "sourcePath": {
      "type": "string"
    },
    "status": {
      "type": "enumeration",
      "enum": ["nieuw", "gelezen", "afgehandeld"],
      "default": "nieuw",
      "required": true
    },
    "teamMailStatus": {
      "type": "enumeration",
      "enum": ["pending", "sent", "skipped", "failed"],
      "default": "pending"
    },
    "visitorMailStatus": {
      "type": "enumeration",
      "enum": ["pending", "sent", "skipped", "failed"],
      "default": "pending"
    },
    "mailError": {
      "type": "text"
    }
  }
}
