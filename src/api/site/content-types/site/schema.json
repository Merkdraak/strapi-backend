{
  "kind": "collectionType",
  "collectionName": "sites",
  "info": {
    "singularName": "site",
    "pluralName": "sites",
    "displayName": "Site"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {
    "content-manager": {
      "visible": false
    }
  },
  "attributes": {
    "key": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "name": {
      "type": "string",
      "required": true
    },
    "domain": {
      "type": "string"
    },
    "editorUrl": {
      "type": "string"
    },
    "phoneDisplay": {
      "type": "string"
    },
    "phoneHref": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "emailHref": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "kvk": {
      "type": "string"
    },
    "btw": {
      "type": "string"
    },
    "hours": {
      "type": "string"
    },
    "defaultTitle": {
      "type": "string"
    },
    "defaultDescription": {
      "type": "text"
    },
    "footerText": {
      "type": "text"
    },
    "footerDisclaimer": {
      "type": "string"
    },
    "articlePrefix": {
      "type": "string",
      "default": "kennisbank"
    },
    "googlePlaceId": {
      "type": "string"
    },
    "formWebhook": {
      "type": "string"
    },
    "menuBackfilled": {
      "type": "boolean",
      "default": false
    }
  }
}
